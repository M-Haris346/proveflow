{
  "schema_version": 1,
  "_comment": "Eval servers for the role classifier (docs/eval/SERVERS.md). Collected ONLY in the ephemeral runner (.github/workflows/eval-collect.yml) with `python -m proveflow.eval.collect`. {workdir} is replaced by the collector with a fresh temp dir. pg-mcp-guard is NOT here: it is collected in-process by scripts/eval_pg_mcp_guard_list_tools.py.",
  "servers": [
    {
      "id": "fetch",
      "source": "reference",
      "package": {"registry": "pypi", "name": "mcp-server-fetch", "version": "2026.10.24"},
      "license": "MIT OR Apache-2.0 (repo LICENSE @6b36e3c)",
      "repo": "https://github.com/modelcontextprotocol/servers",
      "command": "uvx",
      "args": ["mcp-server-fetch@2026.10.24"]
    },
    {
      "id": "filesystem",
      "source": "reference",
      "package": {"registry": "npm", "name": "@modelcontextprotocol/server-filesystem", "version": "2.0.1"},
      "license": "MIT OR Apache-2.0 (repo LICENSE @6b36e3c)",
      "repo": "https://github.com/modelcontextprotocol/servers",
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-filesystem@2.0.1", "{workdir}/fs"],
      "setup": ["mkdir:fs"]
    },
    {
      "id": "git",
      "source": "reference",
      "package": {"registry": "pypi", "name": "mcp-server-git", "version": "2026.10.19"},
      "license": "MIT OR Apache-2.0 (repo LICENSE @6b36e3c)",
      "repo": "https://github.com/modelcontextprotocol/servers",
      "command": "uvx",
      "args": ["mcp-server-git@2026.10.19", "--repository", "{workdir}/repo"],
      "setup": ["git-init:repo"]
    },
    {
      "id": "memory",
      "source": "reference",
      "package": {"registry": "npm", "name": "@modelcontextprotocol/server-memory", "version": "2.0.0"},
      "license": "MIT OR Apache-2.0 (repo LICENSE @6b36e3c)",
      "repo": "https://github.com/modelcontextprotocol/servers",
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-memory@2.0.0"],
      "env": {"MEMORY_FILE_PATH": "{workdir}/memory/memory.jsonl"},
      "setup": ["mkdir:memory"]
    },
    {
      "id": "sequential-thinking",
      "source": "reference",
      "package": {"registry": "npm", "name": "@modelcontextprotocol/server-sequential-thinking", "version": "2.0.0"},
      "license": "MIT OR Apache-2.0 (repo LICENSE @6b36e3c)",
      "repo": "https://github.com/modelcontextprotocol/servers",
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-sequential-thinking@2.0.0"]
    },
    {
      "id": "time",
      "source": "reference",
      "package": {"registry": "pypi", "name": "mcp-server-time", "version": "2026.10.19"},
      "license": "MIT OR Apache-2.0 (repo LICENSE @6b36e3c)",
      "repo": "https://github.com/modelcontextprotocol/servers",
      "command": "uvx",
      "args": ["mcp-server-time@2026.10.19"]
    },
    {
      "id": "playwright",
      "source": "popular",
      "package": {"registry": "npm", "name": "@playwright/mcp", "version": "0.0.83"},
      "license": "Apache-2.0 (LICENSE in tarball)",
      "repo": "https://github.com/microsoft/playwright-mcp",
      "command": "npx",
      "args": ["-y", "@playwright/mcp@0.0.83", "--headless"]
    },
    {
      "id": "chrome-devtools",
      "source": "popular",
      "package": {"registry": "npm", "name": "chrome-devtools-mcp", "version": "1.12.0"},
      "license": "Apache-2.0 (LICENSE in tarball)",
      "repo": "https://github.com/ChromeDevTools/chrome-devtools-mcp",
      "command": "npx",
      "args": ["-y", "-p", "chrome-devtools-mcp@1.12.0", "chrome-devtools-mcp", "--no-usage-statistics"],
      "env": {"CHROME_DEVTOOLS_MCP_NO_USAGE_STATISTICS": "1"},
      "notes": "two bins in package.json; -p + bin name is npx's documented explicit form; usage statistics opt-out (README 1.12.0)"
