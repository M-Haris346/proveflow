{
  "$defs": {
    "RedactedValue": {
      "additionalProperties": false,
      "description": "Irreversible fingerprint of a secret: sha256 prefix + length, nothing else.",
      "properties": {
        "length": {
          "minimum": 0,
          "title": "Length",
          "type": "integer"
        },
        "sha256_prefix": {
          "pattern": "^[0-9a-f]{12}$",
          "title": "Sha256 Prefix",
          "type": "string"
        }
      },
      "required": [
        "sha256_prefix",
        "length"
      ],
      "title": "RedactedValue",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Text whose secret segments are stored only as ``RedactedValue``.",
  "properties": {
    "parts": {
      "default": [],
      "items": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "$ref": "#/$defs/RedactedValue"
          }
        ]
      },
      "title": "Parts",
      "type": "array"
    }
  },
  "title": "RedactedText",
  "type": "object"
}
