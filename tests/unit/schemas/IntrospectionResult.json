{
  "$defs": {
    "IntrospectionStatus": {
      "enum": [
        "ok",
        "skipped_no_launch",
        "declined",
        "consent_required",
        "timeout",
        "failed",
        "config_changed",
        "unresolved_variables",
        "remote_not_introspected",
        "auth_required"
      ],
      "title": "IntrospectionStatus",
      "type": "string"
    },
    "RawTool": {
      "additionalProperties": false,
      "description": "One tool as returned by tools/list, already scrubbed of launch secrets.",
      "properties": {
        "description": {
          "default": "",
          "title": "Description",
          "type": "string"
        },
        "input_schema": {
          "additionalProperties": true,
          "title": "Input Schema",
          "type": "object"
        },
        "name": {
          "title": "Name",
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "title": "RawTool",
      "type": "object"
    },
    "ToolChange": {
      "additionalProperties": false,
      "description": "Difference vs the cached previous tools/list (rug-pull signal, never blocking).",
      "properties": {
        "kind": {
          "$ref": "#/$defs/ToolChangeKind"
        },
        "tool": {
          "title": "Tool",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "tool"
      ],
      "title": "ToolChange",
      "type": "object"
    },
    "ToolChangeKind": {
      "enum": [
        "added",
        "removed",
        "description_changed",
        "schema_changed"
      ],
      "title": "ToolChangeKind",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "baseline": {
      "anyOf": [
        {
          "enum": [
            "first_seen",
            "compared",
            "cache_disabled"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Baseline"
    },
    "changes": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ToolChange"
      },
      "title": "Changes",
      "type": "array"
    },
    "detail": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Detail"
    },
    "era": {
      "anyOf": [
        {
          "enum": [
            "modern",
            "handshake"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Era"
    },
    "pattern_redactions": {
      "default": 0,
      "title": "Pattern Redactions",
      "type": "integer"
    },
    "protocol_version": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Protocol Version"
    },
    "status": {
      "$ref": "#/$defs/IntrospectionStatus"
    },
    "stderr_tail": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Stderr Tail"
    },
    "tools": {
      "default": [],
      "items": {
        "$ref": "#/$defs/RawTool"
      },
      "title": "Tools",
      "type": "array"
    }
  },
  "required": [
    "status"
  ],
  "title": "IntrospectionResult",
  "type": "object"
}
