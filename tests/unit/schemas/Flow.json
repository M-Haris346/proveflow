{
  "$defs": {
    "FlowClass": {
      "enum": [
        "exfil",
        "action",
        "leak"
      ],
      "title": "FlowClass",
      "type": "string"
    },
    "FlowVerdictKind": {
      "enum": [
        "CONFIRMED",
        "NOT_REPRODUCED",
        "THEORETICAL"
      ],
      "title": "FlowVerdictKind",
      "type": "string"
    },
    "Granularity": {
      "description": "``server``: inferred from server name/command only (tools unknown) \u2014 low confidence.",
      "enum": [
        "tool",
        "server"
      ],
      "title": "Granularity",
      "type": "string"
    },
    "SinkSeverity": {
      "description": "Ordered worst-first (ARCHITECTURE \u00a75.3: external network > write > local).",
      "enum": [
        "network_egress",
        "remote_write",
        "local_write"
      ],
      "title": "SinkSeverity",
      "type": "string"
    },
    "ToolRef": {
      "additionalProperties": false,
      "description": "A tool on a server inside one agent profile. ``tool is None``: server-level.",
      "properties": {
        "server": {
          "title": "Server",
          "type": "string"
        },
        "tool": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tool"
        }
      },
      "required": [
        "server"
      ],
      "title": "ToolRef",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Ordered path source \u2192 (private) \u2192 sink inside one agent profile.",
  "properties": {
    "confidence": {
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Confidence",
      "type": "number"
    },
    "cross_server": {
      "title": "Cross Server",
      "type": "boolean"
    },
    "flow_class": {
      "$ref": "#/$defs/FlowClass"
    },
    "granularity": {
      "$ref": "#/$defs/Granularity"
    },
    "id": {
      "title": "Id",
      "type": "string"
    },
    "private": {
      "anyOf": [
        {
          "$ref": "#/$defs/ToolRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "profile": {
      "title": "Profile",
      "type": "string"
    },
    "sink": {
      "$ref": "#/$defs/ToolRef"
    },
    "sink_severity": {
      "$ref": "#/$defs/SinkSeverity"
    },
    "source": {
      "anyOf": [
        {
          "$ref": "#/$defs/ToolRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "verdict": {
      "$ref": "#/$defs/FlowVerdictKind",
      "default": "THEORETICAL"
    }
  },
  "required": [
    "id",
    "profile",
    "flow_class",
    "sink",
    "cross_server",
    "sink_severity",
    "confidence",
    "granularity"
  ],
  "title": "Flow",
  "type": "object"
}
